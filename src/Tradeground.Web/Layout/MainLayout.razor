@inherits LayoutComponentBase

<header class="topbar">
    <a class="logo" href="">
        <span class="logo-mark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 18 18">
                <rect x="2" y="8" width="3" height="7" rx="1" fill="#18203a" />
                <rect x="7.5" y="4" width="3" height="11" rx="1" fill="#18203a" />
                <rect x="13" y="1" width="3" height="14" rx="1" fill="#18203a" />
            </svg>
        </span>
        Tradeground
    </a>
    <nav class="nav" aria-label="Main">
        <NavLink href="" Match="NavLinkMatch.All">Games</NavLink>
        <NavLink href="chart">Up or Down</NavLink>
        @* Trade Through History isn't built yet, so it links to its card on the home page. *@
        <a href="#trade-history" class="hide-narrow">Trade Through History</a>
        <a href="#market-maker" class="hide-narrow">Market Maker</a>
        <a href="#join" class="hide-narrow">Join a room</a>
    </nav>
</header>

@Body

@* One dialog and one toast for the whole app; pages ask for them through the HowTo and Toasts services. *@
<HowToDialog />
<ToastHost />
